//Script to test boolean variables

//TEST CREATING BOOLEAN VARIABLES
VAR TEST1 BOOL T
VAR TEST2 BOOL F
VAR TEST3 BOOL TRUE
VAR TEST4 BOOL FALSE
VAR TEST5 BOOL 1
VAR TEST6 BOOL 0

PRNT "=====TESTING CREATING BOOLEAN VARIABLES====="
PRNT "TEST1 is: " TEST1 " (should be true)"
PRNT "TEST2 is: " TEST2 " (should be false)"
PRNT "TEST3 is: " TEST3 " (should be true)"
PRNT "TEST4 is: " TEST4 " (should be false)"
PRNT "TEST5 is: " TEST5 " (should be true)"
PRNT "TEST6 is: " TEST6 " (should be false)"

//TEST SETTING EXISTING BOOLEAN VARIABLES
SET TEST1 F
SET TEST2 TRUE
SET TEST3 0
SET TEST4 TEST5
SET TEST5 "hi" //should fail
SET TEST6 5 //should fail

PRNT "=====TESTING SETTING EXISTING BOOLEAN VARIABLES====="
PRNT "TEST1 is: " TEST1 " (should be false)"
PRNT "TEST2 is: " TEST2 " (should be true)"
PRNT "TEST3 is: " TEST3 " (should be false)"
PRNT "TEST4 is: " TEST4 " (should be true)"
PRNT "TEST5 is: " TEST5 " (should be true)"
PRNT "TEST6 is: " TEST6 " (should be false)"

//TEST SETTING VARIABLE FROM EXPRESSION
VAR TEST1 BOOL [NOT 1]											//test NOT
VAR TEST2 BOOL [NOT [NOT [NOT NOT 1]]]							//test nested expressions
VAR TEST3 BOOL [NOT [1 AND NOT 0] NAND TRUE]					//test AND, NAND
VAR TEST4 BOOL [F OR [F NOR T] AND [[F XOR NOT T] XNOR F]]		//test OR, NOR, XOR, XNOR

PRNT "=====TESTING EXPRESSION EVALUATION====="
PRNT "TEST1 is " TEST1 " (should be false)"
PRNT "TEST2 is " TEST2 " (should be true)"
PRNT "TEST3 is " TEST3 " (should be true)"
PRNT "TEST4 is " TEST4 " (should be false)"

//TEST COMPARISON OPERATIONS
VAR TEST7 BOOL [3 LESS 5.4]										//test LESS
VAR TEST8 BOOL [4.1111 GRTR 3.77]								//test GRTR
VAR TEST9 BOOL [5.4 LESE 5.4]									//test LESE
VAR TEST10 BOOL [3.77 GRTE 3.77]								//test GRTE

PRNT "=====TESTING COMPARISON EVALUATION====="
PRNT "TEST7 is " TEST7 " (should be true)"
PRNT "TEST8 is " TEST8 " (should be true)"
PRNT "TEST9 is " TEST9 " (should be true)"
PRNT "TEST10 is " TEST10 " (should be true)"
