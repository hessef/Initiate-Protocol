//Script to test boolean variables

//TEST CREATING BOOLEAN VARIABLES
VAR TEST1 BOOL T
VAR TEST2 BOOL F
VAR TEST3 BOOL TRUE
VAR TEST4 BOOL FALSE

PRNT "=====TESTING CREATING BOOLEAN VARIABLES====="
PRNT "TEST1 is: " TEST1 " (should be true)"
PRNT "TEST2 is: " TEST2 " (should be false)"
PRNT "TEST3 is: " TEST3 " (should be true)"
PRNT "TEST4 is: " TEST4 " (should be false)"

//TEST SETTING EXISTING BOOLEAN VARIABLES
SET TEST1 F
SET TEST2 TRUE
SET TEST3 f
SET TEST4 TEST5

PRNT "=====TESTING SETTING EXISTING BOOLEAN VARIABLES====="
PRNT "TEST1 is: " TEST1 " (should be false)"
PRNT "TEST2 is: " TEST2 " (should be true)"
PRNT "TEST3 is: " TEST3 " (should be false)"
PRNT "TEST4 is: " TEST4 " (should be true)"

//TEST SETTING VARIABLE FROM EXPRESSION
VAR TEST1 BOOL [NOT f]											//test NOT
VAR TEST2 BOOL [NOT [NOT [NOT NOT t]]]							//test nested expressions
VAR TEST3 BOOL [NOT [t AND NOT f] NAND TRUE]					//test AND, NAND
VAR TEST4 BOOL [F OR [F NOR T] AND [[F XOR NOT T] XNOR F]]		//test OR, NOR, XOR, XNOR

PRNT "=====TESTING EXPRESSION EVALUATION====="
PRNT "TEST1 is " TEST1 " (should be false)"
PRNT "TEST2 is " TEST2 " (should be true)"
PRNT "TEST3 is " TEST3 " (should be true)"
PRNT "TEST4 is " TEST4 " (should be false)"

//TEST COMPARISON OPERATIONS
VAR TEST7 BOOL [3 LESS 5.4]										//test LESS
VAR TEST8 BOOL [4.1111 GRTR 3.77]								//test GRTR
VAR TEST9 BOOL [5.4 LESE 5.4]									//test LESE
VAR TEST10 BOOL [3.77 GRTE 3.77]								//test GRTE

PRNT "=====TESTING COMPARISON EVALUATION====="
PRNT "TEST7 is " TEST7 " (should be true)"
PRNT "TEST8 is " TEST8 " (should be true)"
PRNT "TEST9 is " TEST9 " (should be true)"
PRNT "TEST10 is " TEST10 " (should be true)"

//TEST EQUALITY AND PRESENCE OPERATIONS
VAR TESTINT INT 2
VAR TESTFLT FLT 4.66
VAR TESTSTR STR "bro"
VAR TEST11 BOOL ["hell" IN "hello"]								//test IN
VAR TEST12 BOOL ["hell" NIN "hello"]							//test NIN
VAR TEST13 BOOL [2 EQL TESTINT]									//test EQL (INT)
VAR TEST14 BOOL [4.66 EQL TESTFLT]								//test EQL (FLT)
VAR TEST15 BOOL ["bro" EQL TESTSTR]								//test EQL (STR)
VAR TEST16 BOOL [1 NEQL TESTINT]								//test NEQL (INT)
VAR TEST17 BOOL [4.55 NEQL TESTFLT]								//test NEQL (FLT)
VAR TEST18 BOOL ["br" NEQL TESTSTR]								//test NEQL (STR)

PRNT "=====TESTING EQUALITY AND PRESENCE EVALUATION====="
PRNT "TEST11 is " TEST11 " (should be true)"
PRNT "TEST12 is " TEST12 " (should be false)"
PRNT "TEST13 is " TEST13 " (should be true)"
PRNT "TEST14 is " TEST14 " (should be true)"
PRNT "TEST15 is " TEST15 " (should be true)"
PRNT "TEST16 is " TEST16 " (should be true)"
PRNT "TEST17 is " TEST17 " (should be true)"
PRNT "TEST18 is " TEST18 " (should be true)"
