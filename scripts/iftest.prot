//This script is for testing the IF, ELIF, and ELSE commands

VAR TEST BOOL F
VAR STATEMENT1 STR "This is the first statement"
VAR INT1 INT 55
VAR FUNC1 INT 12
VAR FUNC2 INT 22
VAR MAIN INT 26
VAR RESULT1 INT 0
JMP ABS MAIN

//FUNCTION 1
ADD RESULT1 INT1 3
IF [RESULT1 NEQL 55]
CALL FUNC2
ELSE
PRNT "LINE 17"
END IF
PRNT STATEMENT1 " (LINE 19)"
RET

//FUNCTION 2
PRNT RESULT1 " (LINE 23)"
RET

//MAIN START
PRNT "=====STARTING IF STATEMENT TEST====="
IF TEST
PRNT "TEST was true! (LINE 29)"
IF [INT1 EQL 55]
PRNT INT1 " (LINE 31)"
ELIF [INT1 EQL 65]
PRNT "Not 55 (LINE 33)"
END IF
CALL FUNC1
CALL FUNC2
ELSE
PRNT "TEST was false! (LINE 38)"
END IF
PRNT "DONE!"
