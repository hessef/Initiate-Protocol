//Variables
VAR X INT 10
VAR Y INT 4
VAR Z INT 0

//Status
PRNT "X is: " X
PRNT "Y is: " Y
PRNT "Z is: " Z

//Test ADD arguments
ADD X               //X = 10 + 1 = 11
ADD Y 2             //Y = 4 + 2 = 6
ADD Z X 3           //Z = 11 + 3 = 14

PRNT "ROUND 1"
PRNT "X is: " X " (should be 11)"
PRNT "Y is: " Y " (should be 6)"
PRNT "Z is: " Z " (should be 14)"

//Test arbitrary number of ADD arguments
ADD X X 22 Y 5      //X = 11 + 22 + 6 + 5 = 44
ADD Y Z Z Y         //Y = 14 + 14 + 6 = 34
ADD Z 1 1 1 1 1     //Z = 1 + 1 + 1 + 1 + 1 = 5

PRNT "ROUND 2"
PRNT "X is: " X " (should be 44)"
PRNT "Y is: " Y " (should be 34)"
PRNT "Z is: " Z " (should be 5)"

//Test SUB arguments
SUB X               //X = 44 - 1 = 43
SUB Y 2             //Y = 34 - 2 = 32
SUB Z X 3           //Z = 43 - 3 = 40

PRNT "ROUND 3"
PRNT "X is: " X " (should be 43)"
PRNT "Y is: " Y " (should be 32)"
PRNT "Z is: " Z " (should be 40)"

//Test arbitrary number of ADD arguments
SUB X X 22 Y 5      //X = 43 - 22 - 32 - 5 = -16
SUB Y Z Z Y         //Y = 40 - 40 - 32 = -32
SUB Z 1 1 1 1 1     //Z = 1 - 1 - 1 - 1 - 1 = -3

PRNT "ROUND 4"
PRNT "X is: " X " (should be -16)"
PRNT "Y is: " Y " (should be -32)"
PRNT "Z is: " Z " (should be -3)"